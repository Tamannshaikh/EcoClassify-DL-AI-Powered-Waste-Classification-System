# Backend
APP_ENV=development
APP_NAME=Smart Waste Classification System
API_PREFIX=/api/v1

# Server
HOST=127.0.0.1
PORT=8000

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Model
MODEL_PATH=../artifacts/models/waste_classifier_mobilenetv2.keras
CLASS_NAMES_PATH=../artifacts/models/class_names.json
MODEL_VERSION=v1.0
MODEL_TYPE=mobilenetv2

# Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=../data/uploads

# Database
DATABASE_URL=sqlite:///../data/waste_classification.db

# Reproducibility
RANDOM_SEED=42

# Smart Recycling Center Finder (Phase 18)
RECYCLING_PROVIDER=curated
GOOGLE_MAPS_API_KEY=
DEFAULT_SEARCH_RADIUS_KM=10.0
MAX_SEARCH_RADIUS_KM=50.0
DEFAULT_SEARCH_LIMIT=10
MAX_SEARCH_LIMIT=20
